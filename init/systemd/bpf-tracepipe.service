# SPDX-License-Identifier: BSD-2-Clause
[Unit]
Description=Forward BPF trace_pipe output to journald
After=systemd-journald.service
Requires=systemd-journald.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/systemd-cat -t bpf -p info /bin/cat /sys/kernel/tracing/trace_pipe
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
